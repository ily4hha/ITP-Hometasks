{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C17: clang — сборка активного файла",
            "command": "/usr/bin/clang",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка C17 с предупреждениями Apple Clang."
        }
    ],
    "version": "2.0.0"
}
